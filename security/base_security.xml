<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Record Rule for Area-Based Access -->
    <record id="invoicing_area_document_only_rule" model="ir.rule">
        <field name="name">Area-Based Invoice Access</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="groups" eval="[(4, ref('area.group_area_based_access'))]"/>
        <field name="domain_force">[('area_id', 'in', user.area_ids.ids)]</field>
    </record>

    <!-- Update the domain_force field of the existing rule of all document and administarator of sale -->
    <record id="sale.account_invoice_rule_see_all" model="ir.rule">
        <field name="domain_force">[('area_id', 'in', user.area_ids.ids)]</field>
    </record>

</odoo>


